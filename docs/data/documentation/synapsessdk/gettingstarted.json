tag, the identity its positions carry."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"The device is located: by default by the BlueGPS antennas, which pick up the tag the"},{"type":"text","text":" "},{"type":"text","text":"device broadcasts, or by another supported positioning system: "},{"identifier":"doc:\/\/com.synapseslab.BlueGPS.SynapsesSDK\/documentation\/SynapsesSDK\/Positioning","isActive":true,"type":"reference"},{"type":"text","text":"."}],"type":"paragraph"}]}],"type":"orderedList"},{"inlineContent":[{"type":"text","text":"The values of your installation (the server, the Keycloak realm, the client IDs) come"},{"type":"text","text":" "},{"type":"text","text":"from Synapses support."}],"type":"paragraph"},{"text":"Add the SDK","level":2,"anchor":"Add-the-SDK","type":"heading"},{"inlineContent":[{"type":"text","text":"Add the Swift package "},{"code":"https:\/\/github.com\/synapseslab\/ios-bluegps-sdk-public","type":"codeVoice"},{"type":"text","text":" to your"},{"type":"text","text":" "},{"type":"text","text":"project and import the module:"}],"type":"paragraph"},{"code":["import SynapsesSDK"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"The SDK supports iOS 17 and later. Build with the Xcode version the release was built"},{"type":"text","text":" "},{"type":"text","text":"with, which the package’s README states."}],"type":"paragraph"},{"text":"Configure your app","level":2,"anchor":"Configure-your-app","type":"heading"},{"inlineContent":[{"type":"text","text":"Describe your installation in "},{"code":"Info.plist","type":"codeVoice"},{"type":"text","text":", under a "},{"code":"SynapsesSDK","type":"codeVoice"},{"type":"text","text":" dictionary:"}],"type":"paragraph"},{"code":["<key>SynapsesSDK<\/key>","<dict>","    <key>defaultURL<\/key>","    <string>https:\/\/bluegps.example.com<\/string>","    <key>KeycloakConfig<\/key>","    <dict>","        <key>authMethod<\/key>","        <string>APPLE<\/string>","        <key>loginMode<\/key>","        <string>USER<\/string>","        <key>clientId<\/key>","        <string>your-client-id<\/string>","        <key>guestClientId<\/key>","        <string>your-guest-client-id<\/string>","        <key>guestSecretKey<\/key>","        <string>your-guest-secret<\/string>","        <key>redirectURI<\/key>","        <string>yourapp:\/\/bluegps.example.com<\/string>","        <key>discoverURL<\/key>","        <string>https:\/\/auth.example.com\/realms\/your-realm\/.well-known\/openid-configuration<\/string>","    <\/dict>","<\/dict>"],"syntax":"xml","type":"codeListing"},{"items":[{"content":[{"inlineContent":[{"code":"authMethod","type":"codeVoice"},{"type":"text","text":": "},{"code":"APPLE","type":"codeVoice"},{"type":"text","text":" signs in through "},{"code":"ASWebAuthenticationSession","type":"codeVoice"},{"type":"text","text":", the system’s web"},{"type":"text","text":" "},{"type":"text","text":"login sheet. It is the method to use."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"loginMode","type":"codeVoice"},{"type":"text","text":": "},{"code":"USER","type":"codeVoice"},{"type":"text","text":" or "},{"code":"GUEST","type":"codeVoice"},{"type":"text","text":", the default kind of sign-in for the installation."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"redirectURI","type":"codeVoice"},{"type":"text","text":": the redirect registered on the realm for your app. Declare its scheme"},{"type":"text","text":" "},{"type":"text","text":"in "},{"code":"CFBundleURLTypes","type":"codeVoice"},{"type":"text","text":", so that a redirect delivered to the app can still complete the"},{"type":"text","text":" "},{"type":"text","text":"login."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"The guest keys are needed only if your app signs in as a guest."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"An "},{"code":"AdvertisingConfig","type":"codeVoice"},{"type":"text","text":" dictionary, beside "},{"code":"KeycloakConfig","type":"codeVoice"},{"type":"text","text":", changes how the device"},{"type":"text","text":" "},{"type":"text","text":"broadcasts its tag. Leave it out unless Synapses technicians ask for it: any other"},{"type":"text","text":" "},{"type":"text","text":"change can interrupt the service or degrade its performance."},{"type":"text","text":" "},{"identifier":"doc:\/\/com.synapseslab.BlueGPS.SynapsesSDK\/documentation\/SynapsesSDK\/Positioning#Advertising-settings","isActive":true,"type":"reference"},{"type":"text","text":" describes it."}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"To configure the SDK in code instead, pass an "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.synapseslab.BlueGPS.SynapsesSDK\/documentation\/SynapsesSDK\/EnvironmentModel"},{"type":"text","text":" with a"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.synapseslab.BlueGPS.SynapsesSDK\/documentation\/SynapsesSDK\/KeycloakEnvironment"},{"type":"text","text":" to "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.synapseslab.BlueGPS.SynapsesSDK\/documentation\/SynapsesSDK\/BlueGPS\/setupSDK(_:)"},{"type":"text","text":"."}],"type":"paragraph"},{"text":"Set up the SDK","level":2,"anchor":"Set-up-the-SDK","type":"heading"},{"inlineContent":[{"type":"text","text":"Call "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.synapseslab.BlueGPS.SynapsesSDK\/documentation\/SynapsesSDK\/BlueGPS\/setupSDK(_:)"},{"type":"text","text":" at launch, before anything else touches the SDK, and"},{"type":"text","text":" "},{"type":"text","text":"discover the Keycloak configuration:"}],"type":"paragraph"},{"code":["@main","struct MyApp: App {","    init() {","        BlueGPS.setupSDK()      \/\/ reads the SynapsesSDK dictionary","    }","","    var body: some Scene {","        WindowGroup {","     