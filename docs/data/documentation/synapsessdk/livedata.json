{"primaryContentSections":[{"content":[{"anchor":"Overview","text":"Overview","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Once the device broadcasts its tag, the BlueGPS antennas pick it up and the BlueGPS"},{"type":"text","text":" "},{"type":"text","text":"server knows where it is. The SDK reads that knowledge in two ways:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"On request","type":"text"}],"type":"strong"},{"text":": the current position of a tag, the areas it is in.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"As it changes"}]},{"type":"text","text":": streams of server-sent events, each delivered to your callbacks"},{"type":"text","text":" "},{"type":"text","text":"through an "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.synapseslab.BlueGPS.SynapsesSDK\/documentation\/SynapsesSDK\/SSEManager"},{"type":"text","text":"."}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"A stream lasts as long as you hold its "},{"type":"reference","identifier":"doc:\/\/com.synapseslab.BlueGPS.SynapsesSDK\/documentation\/SynapsesSDK\/SSEManager","isActive":true},{"type":"text","text":". Keep the reference while you need"},{"type":"text","text":" "},{"type":"text","text":"the updates, and call "},{"type":"reference","identifier":"doc:\/\/com.synapseslab.BlueGPS.SynapsesSDK\/documentation\/SynapsesSDK\/SSEManager\/removeAllListenersAndDisconnect()","isActive":true},{"type":"text","text":" when you are done."},{"type":"text","text":" "},{"type":"text","text":"Callbacks arrive on the main thread."}],"type":"paragraph"},{"level":2,"type":"heading","anchor":"Read-a-position","text":"Read a position"},{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/com.synapseslab.BlueGPS.SynapsesSDK\/documentation\/SynapsesSDK\/BlueGPS\/getCurrentPosition(_:)"},{"type":"text","text":" returns where a tag is now, as a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.synapseslab.BlueGPS.SynapsesSDK\/documentation\/SynapsesSDK\/MapPositionModel"},{"text":":","type":"text"},{"text":" ","type":"text"},{"text":"the map, the coordinates on it and the room. It throws when the server has not located","type":"text"},{"text":" ","type":"text"},{"text":"the tag yet, which is usual for a few seconds after advertising starts.","type":"text"}]},{"code":["let position = try await BlueGPS.shared.getCurrentPosition(tagId)"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"To follow it, start a position stream:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["positionStream = BlueGPS.shared.startNotifyPositionChanges(with: [tagId],","                                                           onValueChanged: { positions in","    guard let latest = positions?[tagId]?.last else { return }","    \/\/ Show it, or pass it to the map.","})"],"syntax":"swift"},{"type":"heading","level":2,"text":"Follow rooms","anchor":"Follow-rooms"},{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/com.synapseslab.BlueGPS.SynapsesSDK\/documentation\/SynapsesSDK\/BlueGPS\/startNotifyRegionChanges(with:regions:checkTimeout:onComplete:onValueChanged:onCheck:)"},{"type":"text","text":" "},{"type":"text","text":"matches each position of the tags against a list of regions, and reports the regions"},{"type":"text","text":" "},{"type":"text","text":"that contain each tag. The rooms of the building come from"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/com.synapseslab.BlueGPS.SynapsesSDK\/documentation\/SynapsesSDK\/BlueGPS\/getRoomsCoordinates()","isActive":true},{"type":"text","text":":"}]},{"type":"codeListing","code":["let rooms = try await BlueGPS.shared.getRoomsCoordinates()","roomStream = BlueGPS.shared.startNotifyRegionChanges(with: [tagId], regions: rooms,","                                                     onValueChanged: { changed in","    let inside = changed?[tagId]?.compactMap(\\.name) ?? []","    \/\/ Compare with the previous value to tell entering from leaving.","})"],"syntax":"swift"},{"type":"heading","level":2,"text":"Read areas","anchor":"Read-areas"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Areas are zones defined on the server, on top of the rooms."},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.synapseslab.BlueGPS.SynapsesSDK\/documentation\/SynapsesSDK\/BlueGPS\/getAreas(search:type:isDesc:order:filterUnknownValues:)"},{"text":" lists them, and","type":"text"},{"type":"text","text":" "},{"identifier":"doc:\/\/com.synapseslab.BlueGPS.SynapsesSDK\/documentation\/SynapsesSDK\/BlueGPS\/getRealtimeElementAreas(id:type:filterUnknownValues:)","isActive":true,"type":"reference"},{"text":" returns the areas an","type":"text"},{"text":" ","type":"text"},{"text":"element is in now: a tag, a user, a group or another ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.synapseslab.BlueGPS.SynapsesSDK\/documentation\/SynapsesSDK\/BGPRealtimeElementType","type":"reference"},{"text":".","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["let areas = try await BlueGPS.shared.getRealtimeElementAreas(id: tagId, type: .TAGS)"]},{"anchor":"Receive-your-installations-events","type":"heading","level":2,"text":"Receive your installation’s events"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/com.synapseslab.BlueGPS.SynapsesSDK\/documentation\/SynapsesSDK\/BlueGPS\/startNotifyEventChanges(with:events:checkTimeout:onComplete:onEventChanges:onCheck:)","type":"reference","isActive":true},{"text":" ","type":"text"},{"text":"delivers events your installation produces, by name: events of a tag, or generic ones,","type":"text"},{"text":" ","type":"text"},{"text":"as ","type":"text"},{"identifier":"doc:\/\/com.synapseslab.BlueGPS.SynapsesSDK\/documentation\/SynapsesSDK\/SSEStreamTypeEvent","isActive":true,"type":"reference"},{"type":"text","text":" says. Synapses support tells you which events your"},{"type":"text","text":" "},{"type":"text","text":"installation sends."}]},{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/com.synapseslab.BlueGPS.SynapsesSDK\/documentation\/SynapsesSDK\/BlueGPS\/startDiagnostic(tags:forgetTagMillis:onComplete:onTagTracking:onCheck:)"},{"type":"text","text":" "},{"type":"text","text":"reports how the BlueGPS antennas are tracking a set of tags, to check an installation."}],"type":"paragraph"},{"anchor":"Track-the-user-with-beacons","type":"heading","level":2,"text":"Track the user with beacons"},{"inlineContent":[{"type":"text","text":"Where the building has beacons, "},{"type":"reference","identifier":"doc:\/\/com.synapseslab.BlueGPS.SynapsesSDK\/documentation\/SynapsesSDK\/BlueGPS\/startTrackingUserPosition(onBeaconDiscovered:onError:)","isActive":true},{"type":"text","text":" "},{"type":"text","text":"reports when the device enters and leaves beacon locations, with the reason, in the"},{"type":"text","text":" "},{"type":"text","text":"background too, and"},{"type":"text","text":" "},{"identifier":"doc:\/\/com.synapseslab.BlueGPS.SynapsesSDK\/documentation\/SynapsesSDK\/BlueGPS\/stopTrackingUserPosition()","type":"reference","isActive":true},{"text":" stops it. Tracking can resume after the app is","type":"text"},{"text":" ","type":"text"},{"text":"closed or the device restarts: set its callbacks again at launch, before the app’s first","type":"text"},{"text":" ","type":"text"},{"text":"scene appears.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"identifier":{"url":"doc:\/\/com.synapseslab.BlueGPS.SynapsesSDK\/documentation\/SynapsesSDK\/LiveData","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Follow positions, rooms, areas and events as the BlueGPS server computes them."}],"metadata