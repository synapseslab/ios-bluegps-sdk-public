larations":[{"languages":["swift"],"platforms":["iOS","iPadOS","Mac Catalyst"],"tokens":[{"text":"class","kind":"keyword"},{"kind":"text","text":" "},{"text":"BGPSLogManager","kind":"identifier"}]}]},{"content":[{"type":"heading","anchor":"overview","level":2,"text":"Overview"},{"inlineContent":[{"text":"Use it for anything you want to survive the session and be readable from the","type":"text"},{"text":" ","type":"text"},{"text":"device — the log file is what support asks for. It is the SDK’s own logging","type":"text"},{"text":" ","type":"text"},{"text":"facility, so an integrator should route diagnostics here rather than introducing","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"a second sink."}],"type":"paragraph"},{"type":"aside","style":"important","name":"Important","content":[{"inlineContent":[{"type":"text","text":"The file grows without bound. Nothing rotates or truncates it, so an"},{"text":" ","type":"text"},{"type":"text","text":"app that logs steadily should call "},{"identifier":"doc:\/\/com.synapseslab.BlueGPS.SynapsesSDK\/documentation\/SynapsesSDK\/BGPSLogManager\/clearLog()","isActive":true,"type":"reference"},{"type":"text","text":" on its own schedule."}],"type":"paragraph"}]},{"type":"aside","style":"note","name":"Note","content":[{"inlineContent":[{"type":"text","text":"A caseless enum would express “namespace” better, but this type is"},{"type":"text","text":" "},{"type":"text","text":"public: turning it into one removes an initialiser integrators can already"},{"text":" ","type":"text"},{"type":"text","text":"call. Useless as that initialiser is, narrowing the public surface of a"},{"type":"text","text":" "},{"type":"text","text":"framework sold to third parties is not a lint fix."}],"type":"paragraph"}]}],"kind":"content"}],"sections":[],"references":{"doc://com.synapseslab.BlueGPS.SynapsesSDK/documentation/SynapsesSDK/BGPSLogManager/redactionPlaceholder":{"identifier":"doc:\/\/com.synapseslab.BlueGPS.SynapsesSDK\/documentation\/SynapsesSDK\/BGPSLogManager\/redactionPlaceholder","abstract":[{"text":"What a sensitive value is logged as while ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.synapseslab.BlueGPS.SynapsesSDK\/documentation\/SynapsesSDK\/BGPSLogManager\/redactsSensitiveData"},{"text":" is on.","type":"text"}],"role":"symbol","title":"redactionPlaceholder","kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"redactionPlaceholder"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"}],"url":"\/documentation\/synapsessdk\/bgpslogmanager\/redactionplaceholder"},"doc://com.synapseslab.BlueGPS.SynapsesSDK/documentation/SynapsesSDK/BGPSLogManager/redactsSensitiveData":{"role":"symbol","url":"\/documentation\/synapsessdk\/bgpslogmanager\/redactssensitivedata","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"kind":"text","text":" "},{"text":"redactsSensitiveData","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}],"identifier":"doc:\/\/com.synapseslab.BlueGPS.SynapsesSDK\/documentation\/SynapsesSDK\/BGPSLogManager\/redactsSensitiveData","abstract":[{"type":"text","text":"Privacy switch for the log. While "},{"code":"true","type":"codeVoice"},{"type":"text","text":", the default, a value that gives"},{"type":"text","text":" "},{"type":"text","text":"access to an account or a device is written as "},{"identifier":"doc:\/\/com.synapseslab.BlueGPS.SynapsesSDK\/documentation\/SynapsesSDK\/BGPSLogManager\/redactionPlaceholder","type":"reference","isActive":true},{"type":"text","text":":"},{"type":"text","text":" "},{"type":"text","text":"access, refresh and ID tokens, "},{"code":"Bearer","type":"codeVoice"},{"type":"text","text":" credentials, OAuth "},{"code":"code","type":"codeVoice"},{"type":"text","text":", "},{"code":"state","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"and PKCE values, client secrets, passwords, push tokens, and the identifiers of"},{"type":"text","text":" "},{"type":"text","text":"the device or the person: the installation UUID, the Keycloak session and"},{"type":"text","text":" "},{"type":"text","text":"user. Not the ids of bookings, tickets and other objects. Call sites pass such"},{"type":"text","text":" "},{"type":"text","text":"values through "},{"identifier":"doc:\/\/com.synapseslab.BlueGPS.SynapsesSDK\/documentation\/SynapsesSDK\/BGPSLogManager\/redacted(_:)","type":"reference","isActive":true},{"type":"text","text":"; "},{"identifier":"doc:\/\/com.synapseslab.BlueGPS.SynapsesSDK\/documentation\/SynapsesSDK\/BGPSLogManager\/log(_:)","type":"reference","isActive":true},{"type":"text","text":" also replaces text in the shape"},{"type":"text","text":" "},{"type":"text","text":"of one, so a line that forgets to still lands clean. The host app turns it"},{"text":" ","type":"text"},{"type":"text","text":"off only for builds that need the raw values to debug."}],"kind":"symbol","type":"topic","title":"redactsSensitiveData"},"doc://com.synapseslab.BlueGPS.SynapsesSDK/documentation/SynapsesSDK/BGPSLogManager/log(_:)":{"url":"\/documentation\/synapsessdk\/bgpslogmanager\/log(_:)","kind":"symbol","abstract":[{"type":"text","text":"Writes one timestamped line to the console and to "},{"type":"codeVoice","code":"console.log"},{"type":"text","text":"."}],"identifier":"doc:\/\/com.synapseslab.BlueGPS.SynapsesSDK\/documentation\/SynapsesSDK\/BGPSLogManager\/log(_:)","type":"topic","title":"log(_:)","role":"symbol","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"log"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},